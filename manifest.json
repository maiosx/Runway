{
  "schemaVersion": 1,
  "id": "runway.forecast",
  "name": "Runway",
  "version": "1.1.1",
  "author": "maiosx",
  "license": "MIT",
  "description": "Checking-account cash forecast for the Omarchy desktop.",
  "kinds": ["overlay", "bar-widget"],
  "keepLoaded": true,
  "entryPoints": {
